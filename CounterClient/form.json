{
    "elements": [
        {
            "type": "SelectCategory",
            "name": "CounterCategoryID",
            "caption": "Counter Kategorie"
        },
        {
            "type": "SelectVariable",
            "name": "JsonOutputVariableID",
            "caption": "JSON Ausgabe Variable",
            "validVariableTypes": [3]
        },
        { "type": "NumberSpinner", "name": "Projectyear", "caption": "Projectyear" },
        { "type": "NumberSpinner", "name": "Projectnumber", "caption": "Projectnumber" },
        { "type": "ValidationTextBox", "name": "Projectname", "caption": "Projectname" },
        {
            "type": "ExpansionPanel",
            "caption": "MQTT (optional)",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "EnableMQTT",
                    "caption": "MQTT senden"
                },
                {
                    "type": "SelectInstance",
                    "name": "MqttClientID",
                    "caption": "MQTT Client",
                    "visible": "EnableMQTT"
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "UpdateTime",
            "caption": "Aktualisierungszeit (Sekunden)",
            "digits": 0
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Testlauf (JSON erzeugen)",
            "onClick": "SECC_BuildAndStorePayload($id);"
        }
    ]
}